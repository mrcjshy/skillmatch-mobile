# SkillMatch Mobile — local environment variable template
# Real secret/config values must never be committed here.

EXPO_PUBLIC_SUPABASE_URL=

# Preferred modern client credential:
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback only when the existing Supabase project still uses an anon key:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Enable only after hosted Supabase phone-change confirmations and the SMS
# provider have been configured and delivery-tested.
EXPO_PUBLIC_PHONE_OTP_ENABLED=false
