# SkillMatch Mobile — local environment variable template
# Real secret/config values must never be committed here.

EXPO_PUBLIC_SUPABASE_URL=

# Preferred modern client credential:
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback only when the existing Supabase project still uses an anon key:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android Maps SDK key for the Client Job-location picker (react-native-maps).
# Restrict this key to package com.mrcjshy.skillmatch and the authorized SHA-1.
# Used at native-config/prebuild time. Do not commit a real or unrestricted key.
# GOOGLE_MAPS_ANDROID_API_KEY=
