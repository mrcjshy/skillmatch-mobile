{
  "expo": {
    "name": "SkillMatch UI-V3 QA",
    "slug": "skillmatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skillmatchuiv3qa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.mrcjshy.skillmatch.uiv3qa",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8FF",
          "dark": {
            "backgroundColor": "#FBF8FF",
            "image": "./assets/images/itik-splash.png"
          },
          "image": "./assets/images/itik-splash.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "defaultChannel": "skillmatch_alerts_v1",
          "sounds": [
            "./assets/sounds/skillmatch_tugma.wav"
          ],
          "icon": "./assets/images/notification-icon.png",
          "color": "#1C3AA6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SkillMatch uses your photos so you can attach project images to your portfolio.",
          "cameraPermission": "SkillMatch uses your camera only during a video call you start or accept on a confirmed booking.",
          "microphonePermission": "SkillMatch uses your microphone only during a video call you start or accept on a confirmed booking."
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "SkillMatch uses your camera only during a video call you start or accept on a confirmed booking.",
          "microphonePermission": "SkillMatch uses your microphone only during a video call you start or accept on a confirmed booking."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd7953f8-210a-492a-a8e1-9fd842246159"
      }
    },
    "owner": "mrcjshy"
  }
}
